# --- Database ---
POSTGRES_USER=polarops
POSTGRES_PASSWORD=changeme
POSTGRES_DB=polarops
DATABASE_URL=postgresql+asyncpg://polarops:changeme@localhost:5432/polarops

# --- Auth ---
JWT_SECRET=changeme-generate-a-long-random-string
